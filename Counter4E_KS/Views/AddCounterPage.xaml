<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter4E_KS.AddCounterPage"
             Title="Nowy licznik">
    <VerticalStackLayout Padding="20"
                         Spacing="15"
                         VerticalOptions="Center">
        <Label Text="Nazwa licznika: "
               FontSize="18"
               HorizontalOptions="Center" />
        <Entry x:Name="CounterNameEntry"
               Placeholder="Wpisz nazwę licznika" />
        <Entry x:Name="CounterValueEntry"
               TextChanged="numbersFiltration"
               Placeholder="Wpisz wartość licznika(wymagane inaczej aplikacja się zamknie)" />
        <Button Text="Dodaj"
                Clicked="OnAddCounterClicked"
                Margin="0,10,0,0" />
    </VerticalStackLayout>
</ContentPage>