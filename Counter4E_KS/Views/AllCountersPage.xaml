<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter4E_KS.AllCountersPage"
             Title="Wszystkie liczniki">
    <Grid RowDefinitions="*, auto">
        <CollectionView x:Name="CountersCollectionView"
                        Grid.Row="0"
                        Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="15"
                            Margin="5">

                    <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Name}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                            <Label Text="{Binding Value, StringFormat='Licznik: {0}'}"
                                   FontSize="26"
                                   HorizontalOptions="Center"/>
                            <HorizontalStackLayout Spacing="8"
                                                   HorizontalOptions="Center">
                                <Button Text="+"
                                        Clicked="OnPlusClicked"
                                        WidthRequest="80"/>
                                <Button Text="-"
                                        Clicked="OnMinusClicked"
                                        WidthRequest="80"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Dodaj nowy licznik"
                Grid.Row="1"
                Clicked="OnGoToAddCounterClicked"
                Margin="15"/>
    </Grid>
</ContentPage>